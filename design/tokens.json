      "main/on": "{ink.900}",
      "focus/ring": "{tan.500}",
      "mark/name": "{blue.dark-text}",
      "mark/name-tint": "{blue.dark-tint}",
      "mark/place": "{red.dark-text}",
      "mark/place-tint": "{red.dark-tint}",
      "mark/word": "#7F7565",
