  "typography": {
    "family": {
      "display": "Newsreader",
      "ui": "Figtree",
      "hebrew": "Frank Ruhl Libre",
      "greek": "Gentium Plus",
      "fallback": {
        "display": "Georgia, serif",
        "ui": "Segoe UI, system-ui, sans-serif"
      },
      "note": "Bundle the font files inside the Windows app. Do not load them from the internet."
    },
    "scale": {
      "display": {
        "family": "display",
        "size": 44,
        "line": 48,
        "weight": 400,
        "tracking": "-0.01em",
        "use": "Greeting on the Start portal"
      },
      "title": {
        "family": "display",
        "size": 34,
        "line": 40,
        "weight": 400,
        "tracking": "-0.01em",
        "use": "Page titles"
      },
      "section": {
        "family": "display",
        "size": 22,
        "line": 28,
        "weight": 400,
        "tracking": "0",
        "use": "Card and section headings"
      },
      "body": {
        "family": "ui",
        "size": 14,
        "line": 22,
        "weight": 400,
        "tracking": "0",
        "use": "Interface text"
      },
      "body-strong": {
        "family": "ui",
        "size": 14,
        "line": 22,
        "weight": 600,
        "tracking": "0",
        "use": "Names, buttons, table headers"
      },
      "small": {
        "family": "ui",
        "size": 12,
        "line": 16,
        "weight": 400,
        "tracking": "0",
        "use": "Captions, meta"
      },
      "label": {
        "family": "ui",
        "size": 11,
        "line": 14,
        "weight": 600,
        "tracking": "0.08em",
        "case": "uppercase",
        "use": "Eyebrows"
      },
      "reading": {
        "family": "display",
        "size": 19,
        "line": 32,
        "weight": 400,
        "tracking": "0",
        "use": "Scripture text (user adjustable 15 to 26)"
      },
      "verse-number": {
        "family": "ui",
        "size": 11,
        "line": 11,
        "weight": 600,
        "use": "Superscript verse numbers"
      },
      "numeral": {
        "family": "ui",
        "feature": "tabular-nums",
        "use": "Counts, times, plan math"
      }
    }
  },
  "space": {
    "unit": 4,
    "scale": [4, 8, 12, 16, 20, 24, 32, 40, 56, 72],
    "card-padding": {
      "comfortable": 24,
      "compact": 16
    },
    "gap": {
      "tight": 8,
      "default": 16,
      "loose": 24
    },
    "page-gutter": 32
  },
  "radius": {
    "control": 8,
    "card": 14,
    "panel": 18,
    "shell": 20,
    "pill": 999
  },
  "border": {
    "hairline": 1,
    "focus": 2
  },
  "shadow": {
    "card": "none",
    "raised": "0 1px 2px rgba(55,46,31,0.05), 0 8px 24px rgba(55,46,31,0.07)",
    "shell": "0 1px 2px rgba(55,46,31,0.04), 0 16px 48px rgba(55,46,31,0.08)",
    "dark-raised": "0 1px 2px rgba(0,0,0,0.4), 0 8px 24px rgba(0,0,0,0.3)"
  },
  "motion": {
    "feel": "macOS and iOS: movement that follows physical springs, starts fast, settles softly, and can be interrupted mid-motion without jumping",
    "springs": {
      "note": "Starting values for the app's animation library (Framer Motion style). Tune by feel on a real screen.",
      "smooth": {
        "stiffness": 260,
        "damping": 32,
        "mass": 1,
        "bounce": "none",
        "use": "Panels, sidebars, page changes, sheets"
      },
      "snappy": {
        "stiffness": 420,
        "damping": 30,
        "mass": 1,
        "bounce": "slight",
        "use": "Buttons, toggles, tab indicator, selection"
      },
      "bouncy": {
        "stiffness": 300,
        "damping": 18,
        "mass": 1,
        "bounce": "noticeable",
        "use": "Rare celebrations such as finishing a book"
      }
    },
    "css-fallback": {
      "smooth": "cubic-bezier(0.32, 0.72, 0, 1)",
      "snappy": "cubic-bezier(0.22, 1, 0.36, 1)",
      "bouncy": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "duration": {
      "instant": 90,
      "fast": 150,
      "base": 250,
      "slow": 400,
      "sheet": 450
    },
    "animate-only": ["opacity", "transform", "filter (blur, short)"],
    "patterns": {
      "press": "Buttons and tiles scale to 0.97 on press and spring back (snappy)",
      "hover": "A soft background fade over 150 ms; no movement except tiles, which rise 2px",
      "tab-indicator": "One selected pill slides between tabs and stretches slightly in transit (snappy), not a hard swap",
      "page-change": "Outgoing view fades and drifts 6px; incoming view fades in from 8px below (smooth, 250 ms)",
      "sidebar": "Collapse and expand follow the drag or click with a spring; labels fade while the width changes (smooth)",
      "study-panel": "Slides in from the right at 380 px with a soft fade and can be dragged closed (smooth)",
      "sheet": "Settings, sign-in, and the command palette rise from slightly below, scale from 0.97 to 1, and dim the page behind with a light blur (sheet, 450 ms)",
      "popover": "Cards for names, places, and words scale from 0.96 to 1 starting at the tapped word, fade in over 150 ms",
      "list": "New rows ease in from 4px below; removed rows collapse in height; reordering uses matched positions so rows glide",
      "highlight": "A chosen highlight color spreads across the verse from left to right in 250 ms",
      "verse-of-the-day": "The old verse fades and lifts 6px while the new one fades in from 6px below",
      "progress": "Rings and bars fill with a smooth spring when a value changes",
      "scroll": "Native smooth scrolling with momentum; sticky headers gain a hairline once content passes under them"
    },
    "interruptible": "Every animation can be reversed or redirected mid-flight, as on macOS",
    "reduced-motion": "When the system asks for reduced motion, replace movement with a 100 ms fade and no scaling"
  },
  "layout": {
    "rail": {
      "width": 232,
      "collapsed": 64
    },
    "topbar": {
      "height": 56
    },
    "study-panel": {
      "width": 380
    },
    "reading-column": {
      "default": 640,
      "min": 480,
      "max": 780
    },
    "content-max": 1160,
    "breakpoints": {
      "compact": 860,
      "medium": 1060
    }
  },
  "icons": {
    "style": "line",
    "stroke": 1.5,
    "size": [18, 20, 24],
    "caps": "round",
    "joins": "round",
    "source": "Lucide, or drawn to match"
  },
  "components": {
    "nav-item": {
      "height": 40,
      "radius": 10,
      "selected": "bg/selected with text/primary and a tan-700 icon",
      "hover": "bg/sunken"
    },
    "button-primary": {
      "bg": "main/fill",
      "text": "main/on",
      "hover": "main/hover",
      "pressed": "main/pressed",
      "radius": 9,
      "height": 36,
      "weight": 600
    },
    "button-secondary": {
      "bg": "bg/card",
      "border": "line/default",
      "text": "text/primary",
      "hover": "bg/sunken"
    },
    "button-ghost": {
      "bg": "transparent",
      "text": "text/secondary",
      "hover": "bg/sunken"
    },
    "card": {
      "bg": "bg/card",
      "border": "line/default",
      "radius": 14,
      "shadow": "none"
    },
    "status-pill": {
      "radius": 999,
      "padding": "4px 12px",
      "size": 12,
      "weight": 600,
      "states": ["progress", "pending", "done"]
    },
    "table-row": {
      "height": 48,
      "divider": "line/default",
      "header": "label style, text/secondary"
    },
    "input": {
      "height": 38,
      "bg": "bg/card",
      "border": "line/default",
      "radius": 9,
      "focus": "focus/ring 2px"
    },
    "tabs": {
      "container": "bg/sunken, radius 10",
      "selected": "bg/card with a hairline"
    },
    "chip": {
      "bg": "bg/sunken",
      "text": "text/secondary",
      "radius": 999
    },
    "ai-marker": {
      "icon": "sparkle in ai/sparkle",
      "use": "Beside the greeting and on every AI-written overview, quiz card, and answer"
    },
    "name-mark": {
      "color": "mark/name",
      "underline": "1.5px at 45% opacity",
      "hover": "mark/name-tint"
    },
    "place-mark": {
      "color": "mark/place",
      "underline": "1.5px at 45% opacity",
      "hover": "mark/place-tint"
    },
    "word-mark": {
      "color": "text/primary",
      "underline": "1.5px dotted mark/word"
    },
    "verse-selected": {
      "outline": "2px focus/ring"
    },
    "today-chip": {
      "bg": "today/bg",
      "radius": 10
    }
  },
