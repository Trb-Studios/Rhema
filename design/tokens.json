{
  "meta": {
    "name": "Rhema style",
    "version": "0.2",
    "status": "in use",
    "source": "v0.1's warm workspace reference, moved dark-first after Linear and Raycast references: near-black neutral surfaces, hairlines, glass popovers, keyboard hints, tan as the one accent",
    "main": "#D6C2A5",
    "theme": "Dark is the default. Light applies when chosen in the app, or when the system prefers light and nothing has been chosen.",
    "note": "#D6C2A5 is a surface and button color. It fails as text on light backgrounds (1.73:1 on white), so tan-colored text uses tan-800 in light. On dark it is fine as text (11:1).",
    "css": "app/src/styles/tokens.css is what the app loads; design/tokens.css is a copy of it.",
    "figma": "Primitives and Semantic are separate collections. Semantic has Light and Dark modes. Names use slashes so they import as groups."
  },
