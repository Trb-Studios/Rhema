{
  "meta": {
    "name": "Rhema style",
    "version": "0.1",
    "status": "draft for review",
    "source": "User reference screenshot (warm off-white workspace UI with serif headings, hairline cards, pastel status pills, gold sparkle) plus main color #D6C2A5",
    "main": "#D6C2A5",
    "note": "#D6C2A5 is a surface and button color. It fails as text on light backgrounds (1.73:1 on white), so tan-colored text uses tan-800.",
    "figma": "Primitives and Semantic are separate collections. Semantic has Light and Dark modes. Names use slashes so they import as groups."
  },
  "primitives": {
    "tan": {
      "50": "#FBF9F6",
      "100": "#F7F2EB",
