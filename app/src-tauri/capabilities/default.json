{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app window is allowed to do. Kept to the minimum it needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-message"
  ]
}
